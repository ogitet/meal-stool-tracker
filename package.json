{
  "name": "hibi-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "demo": "vp dev --mode demo --port 5199 --strictPort",
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "vp build",
    "preview": "vp preview",
    "build-storybook": "storybook build",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "markuplint": "markuplint index.html \"src/**/*.tsx\"",
    "stylelint": "stylelint \"src/**/*.css\"",
    "test": "vp test run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-hibi-log \"vp test run --config firestore-tests/vite.config.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icons": "node scripts/gen-icons.mjs",
    "deploy": "npm run build && firebase deploy",
    "prepare": "vp config"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "firebase": "^13.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@markuplint/jsx-parser": "^5.6.1",
    "@markuplint/react-spec": "^5.6.1",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-tools": "^15.36.0",
    "markuplint": "^5.6.1",
    "storybook": "^10.6.7",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "storybook": {
      "vite-plus": "$vite-plus"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "volta": {
    "node": "26.13.1"
  }
}
