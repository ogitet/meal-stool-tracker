rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ログインした本人の領域（users/{uid}/...）だけを読み書きできる。
    // 新規登録はアプリに設けず、Authentication の「ユーザー作成」も無効にして
    // 利用者を本人1名に限定する（docs/06-tech.md 5章）。
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isDateKey(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // サーバーが付ける日時（createdAt・updatedAt）。無いか、timestamp であること。
    function isOptionalTimestamp(data, key) {
      return !(key in data) || data[key] is timestamp;
    }

    // 値の形は、画面が書き込む内容（src/data/）に合わせる。決めていないフィールドは保存させない。
    match /users/{uid}/categories/{id} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'abbr', 'group', 'active', 'order'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 10
        && request.resource.data.abbr is string
        && request.resource.data.abbr.size() >= 1
        // 略称は1文字。絵文字などは2と数えられることがあるため、2まで通す
        && request.resource.data.abbr.size() <= 2
        && request.resource.data.group in ['staple', 'protein', 'vegetable', 'other', 'sweets']
        && request.resource.data.active is bool
        && request.resource.data.order is number;
      // 削除はせず「使わない」にする（Scope Q7）
      allow delete: if false;
    }

    match /users/{uid}/meals/{id} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['date', 'slot', 'categoryIds', 'createdAt', 'updatedAt'])
        && isDateKey(request.resource.data.date)
        && request.resource.data.slot in ['breakfast', 'lunch', 'dinner', 'other']
        && request.resource.data.categoryIds is list
        && request.resource.data.categoryIds.size() >= 1
        // ルールでは配列の全要素を調べられないため、件数の上限と先頭の型だけを確かめる
        && request.resource.data.categoryIds.size() <= 100
        && request.resource.data.categoryIds[0] is string
        && isOptionalTimestamp(request.resource.data, 'createdAt')
        && isOptionalTimestamp(request.resource.data, 'updatedAt');
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/stools/{id} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
          ['date', 'occurredAt', 'shape', 'amount', 'feeling', 'createdAt', 'updatedAt'])
        && isDateKey(request.resource.data.date)
        && request.resource.data.occurredAt is timestamp
        && request.resource.data.shape in ['hard', 'normal', 'soft', 'diarrhea']
        && (!('amount' in request.resource.data) || request.resource.data.amount in ['small', 'normal', 'large'])
        && (!('feeling' in request.resource.data) || request.resource.data.feeling in ['clear', 'residual'])
        && isOptionalTimestamp(request.resource.data, 'createdAt')
        && isOptionalTimestamp(request.resource.data, 'updatedAt');
      allow delete: if isOwner(uid);
    }
  }
}
