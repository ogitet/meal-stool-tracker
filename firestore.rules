rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ログインした本人の領域（users/{uid}/...）だけを読み書きできる。
    // 新規登録はアプリに設けず、Authentication の「ユーザー作成」も無効にして
    // 利用者を本人1名に限定する（docs/06-tech.md 5章）。
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isDateKey(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // サーバーが付ける日時（createdAt・updatedAt）。無いか、timestamp であること。
    function isOptionalTimestamp(data, key) {
      return !(key in data) || data[key] is timestamp;
    }

    // 値の形は、画面が書き込む内容（src/data/）に合わせる。決めていないフィールドは保存させない。

    // 初版のカテゴリと食事記録。消さずに残し、引き継ぎ（Scope F-16）で読むだけにする（06-tech Q73）
    match /users/{uid}/categories/{id} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /users/{uid}/meals/{id} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // 減らしたいもの・続けたいことの項目（06-tech 10章）
    function isItem(data) {
      return data.keys().hasOnly(['kind', 'name', 'abbr', 'active', 'order'])
        && data.kind in ['reduce', 'keep']
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 10
        && data.abbr is string
        && data.abbr.size() >= 1
        // 略称は1文字。絵文字などは2と数えられることがあるため、2まで通す
        && data.abbr.size() <= 2
        && data.active is bool
        && data.order is number;
    }

    match /users/{uid}/items/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isItem(request.resource.data);
      // 種類は変えない（Structure Q70）
      allow update: if isOwner(uid) && isItem(request.resource.data)
        && request.resource.data.kind == resource.data.kind;
      // 削除はせず「使わない」にする（Scope F-15）
      allow delete: if false;
    }

    // 記録。文書IDは「日付_項目」で、同じ日の同じ項目を1件にする（06-tech Q72）。
    // 2台で同時に押したときの上書きも、同じ内容なら通す
    match /users/{uid}/marks/{id} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['date', 'itemId', 'createdAt'])
        && isDateKey(request.resource.data.date)
        && request.resource.data.itemId is string
        && request.resource.data.itemId.size() >= 1
        && request.resource.data.itemId.size() <= 100
        && id == request.resource.data.date + '_' + request.resource.data.itemId
        && isOptionalTimestamp(request.resource.data, 'createdAt');
      allow delete: if isOwner(uid);
    }

    // 設定（起点日と、引き継ぎ済みか）
    match /users/{uid}/meta/{id} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && id == 'habits'
        && request.resource.data.keys().hasOnly(['startDate', 'migrated'])
        && isDateKey(request.resource.data.startDate)
        && request.resource.data.migrated is bool;
      allow delete: if false;
    }

    match /users/{uid}/stools/{id} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
          ['date', 'occurredAt', 'shape', 'amount', 'feeling', 'createdAt', 'updatedAt'])
        && isDateKey(request.resource.data.date)
        && request.resource.data.occurredAt is timestamp
        && request.resource.data.shape in ['hard', 'normal', 'soft', 'diarrhea']
        && (!('amount' in request.resource.data) || request.resource.data.amount in ['small', 'normal', 'large'])
        && (!('feeling' in request.resource.data) || request.resource.data.feeling in ['clear', 'residual'])
        && isOptionalTimestamp(request.resource.data, 'createdAt')
        && isOptionalTimestamp(request.resource.data, 'updatedAt');
      allow delete: if isOwner(uid);
    }
  }
}
